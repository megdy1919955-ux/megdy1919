rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Room Entity Validation Helper (Strict Typing & Volumetric Bounds)
    function isValidRoom(data) {
      return data.roomId is string && data.roomId.size() > 0 && data.roomId.size() <= 128 &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
             (!('wallpaperUrl' in data) || (data.wallpaperUrl is string && data.wallpaperUrl.size() <= 5000000)) &&
             (!('roomTitle' in data) || (data.roomTitle is string && data.roomTitle.size() <= 500)) &&
             (!('roomAvatar' in data) || (data.roomAvatar is string && data.roomAvatar.size() <= 5000000)) &&
             (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 200)) &&
             (!('wallpaperName' in data) || (data.wallpaperName is string && data.wallpaperName.size() <= 200)) &&
             (!('themeConfig' in data) || (data.themeConfig is map)) &&
             (!('createdAt' in data) || (data.createdAt is string)) &&
             (!('updatedAt' in data) || (data.updatedAt is string));
    }

    // Emoji Slot Entity Validation
    function isValidEmojiSlot(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.slotIndex is number &&
             data.emoji is string && data.emoji.size() <= 100 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('iconUrl' in data) || (data.iconUrl is string && data.iconUrl.size() <= 5000000)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('badge' in data) || (data.badge is string && data.badge.size() <= 50)) &&
             (!('isVip' in data) || (data.isVip is bool)) &&
             (!('animationType' in data) || (data.animationType is string && data.animationType.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string));
    }

    // User Profile Entity Validation
    function isValidUser(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('coins' in data) || (data.coins is number)) &&
             (!('diamonds' in data) || (data.diamonds is number)) &&
             (!('level' in data) || (data.level is number)) &&
             (!('sender_exp' in data) || (data.sender_exp is number)) &&
             (!('sender_level' in data) || (data.sender_level is number)) &&
             (!('receiver_exp' in data) || (data.receiver_exp is number)) &&
             (!('receiver_level' in data) || (data.receiver_level is number)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 5000000)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('age' in data) || (data.age is number)) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
             (!('hasCompletedOnboarding' in data) || (data.hasCompletedOnboarding is bool)) &&
             (!('googleUid' in data) || (data.googleUid is string && data.googleUid.size() <= 128)) &&
             (!('vipTier' in data) || (data.vipTier is string && data.vipTier.size() <= 50)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string)) &&
             (!('createdAt' in data) || (data.createdAt is string));
    }

    // User Profiles & Realtime Balance Collection
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) &&
                               isValidUser(incoming()) &&
                               incoming().id == userId;
      allow delete: if isValidId(userId) && isSignedIn();
    }

    // Voice Room Theme & Wallpaper Collection
    match /rooms/{roomId} {
      // Any visitor in the voice room can read the room's theme and wallpaper
      allow get: if isValidId(roomId);
      allow list: if true;

      // Creation & Update: Allowed with valid payload format and matching room id
      allow create, update: if isValidId(roomId) &&
                               isValidRoom(incoming()) &&
                               incoming().roomId == roomId;

      // Deletion: Restricted
      allow delete: if isValidId(roomId) && isSignedIn();

      // Real-time Chat Messages
      match /messages/{messageId} {
        allow read, write: if isValidId(roomId);
      }

      // Real-time Mic Seats (Who is on which seat, muted, speaking)
      match /seats/{seatId} {
        allow read, write: if isValidId(roomId);
      }

      // Real-time Cinema Video Watch Together
      match /cinema/{cinemaDoc} {
        allow read, write: if isValidId(roomId);
      }

      // Real-time WebRTC Audio & Video Signaling
      match /signals/{signalId} {
        allow read, write: if isValidId(roomId);
      }

      // Real-time Room Events (Gifts, Reactions, Entrance)
      match /events/{eventId} {
        allow read, write: if isValidId(roomId);
      }
    }

    // Dashboard Managed Emojis Collection (Live synced with Voice Room)
    match /app_emojis/{slotId} {
      // Read by all voice room clients
      allow get, list: if true;

      // Writeable by admin or dashboard updates
      allow create, update: if isValidId(slotId) &&
                               isValidEmojiSlot(incoming()) &&
                               incoming().id == slotId;

      allow delete: if isValidId(slotId);
    }

    // Silent Sync Signal Metadata (Version tags for emojis, cards, etc.)
    match /app_meta/{metaDoc} {
      allow get, list: if true;
      allow create, update: if isValidId(metaDoc) &&
                               incoming().id is string &&
                               incoming().version is number;
      allow delete: if isValidId(metaDoc);
    }
  }
}
