rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Room Entity Validation Helper (Strict Typing & Volumetric Bounds)
    function isValidRoom(data) {
      return data.roomId is string && data.roomId.size() > 0 && data.roomId.size() <= 128 &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
             (!('wallpaperUrl' in data) || (data.wallpaperUrl is string && data.wallpaperUrl.size() <= 5000000)) &&
             (!('roomTitle' in data) || (data.roomTitle is string && data.roomTitle.size() <= 500)) &&
             (!('roomAvatar' in data) || (data.roomAvatar is string && data.roomAvatar.size() <= 5000000)) &&
             (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 200)) &&
             (!('wallpaperName' in data) || (data.wallpaperName is string && data.wallpaperName.size() <= 200)) &&
             (!('themeConfig' in data) || (data.themeConfig is map)) &&
             (!('createdAt' in data) || (data.createdAt is string)) &&
             (!('updatedAt' in data) || (data.updatedAt is string));
    }

    // Voice Room Theme & Wallpaper Collection
    match /rooms/{roomId} {
      // Any visitor in the voice room can read the room's theme and wallpaper
      allow get: if isValidId(roomId);
      allow list: if true;

      // Creation & Update: Allowed with valid payload format and matching room id
      allow create, update: if isValidId(roomId) &&
                               isValidRoom(incoming()) &&
                               incoming().roomId == roomId;

      // Deletion: Restricted
      allow delete: if isValidId(roomId) && isSignedIn();
    }
  }
}
