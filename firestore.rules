rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Room Entity Validation Helper (Strict Typing & Volumetric Bounds)
    function isValidRoom(data) {
      return data.roomId is string && data.roomId.size() > 0 && data.roomId.size() <= 64 &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
             data.wallpaperUrl is string && data.wallpaperUrl.size() > 0 && data.wallpaperUrl.size() <= 2048 &&
             (!('roomTitle' in data) || (data.roomTitle is string && data.roomTitle.size() <= 150)) &&
             (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 100)) &&
             (!('wallpaperName' in data) || (data.wallpaperName is string && data.wallpaperName.size() <= 100)) &&
             (!('themeConfig' in data) || (data.themeConfig is map));
    }

    // Voice Room Theme & Wallpaper Collection
    match /rooms/{roomId} {
      // Any visitor in the voice room can read the room's theme and wallpaper
      allow get: if isValidId(roomId);
      allow list: if true;

      // Creation: Only allowed if valid room payload and matching path ID
      allow create: if isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().roomId == roomId;

      // Update: Room owner modification logic (immutable ownerId and roomId)
      allow update: if isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().roomId == roomId &&
                       (
                         !('ownerId' in existing()) ||
                         incoming().ownerId == existing().ownerId
                       );

      // Deletion: Restricted
      allow delete: if isValidId(roomId) &&
                       isSignedIn() &&
                       existing().ownerId == request.auth.uid;
    }
  }
}
