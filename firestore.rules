rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // Room Entity Validation Helper
    function isValidRoom(data) {
      return data.roomId is string && data.roomId.size() > 0 && data.roomId.size() <= 128 &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
             (!('wallpaperUrl' in data) || (data.wallpaperUrl is string && data.wallpaperUrl.size() <= 5000000)) &&
             (!('roomTitle' in data) || (data.roomTitle is string && data.roomTitle.size() <= 500)) &&
             (!('roomAvatar' in data) || (data.roomAvatar is string && data.roomAvatar.size() <= 5000000)) &&
             (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 200)) &&
             (!('wallpaperName' in data) || (data.wallpaperName is string && data.wallpaperName.size() <= 200)) &&
             (!('themeConfig' in data) || (data.themeConfig is map)) &&
             (!('createdAt' in data) || (data.createdAt is string)) &&
             (!('updatedAt' in data) || (data.updatedAt is string));
    }

    // Voice Room Theme & Wallpaper Collection
    match /rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if true;
      allow create, update: if isValidId(roomId) && (!('roomId' in incoming()) || incoming().roomId == roomId);
      allow delete: if isValidId(roomId);

      // Real-time Chat Messages
      match /messages/{messageId} {
        allow read, write: if isValidId(roomId);
      }

      // Real-time Mic Seats (Who is on which seat, muted, speaking)
      match /seats/{seatId} {
        allow read, write: if isValidId(roomId);
      }

      // Real-time Cinema Video Watch Together
      match /cinema/{cinemaDoc} {
        allow read, write: if isValidId(roomId);
      }

      // Real-time WebRTC Audio & Video Signaling
      match /signals/{signalId} {
        allow read, write: if isValidId(roomId);
      }

      // Real-time Room Events (Gifts, Reactions, Entrance)
      match /events/{eventId} {
        allow read, write: if isValidId(roomId);
      }

      // Real-time Room Leaderboard & Stats (Supporters, Charm, Club)
      match /supporters/{supporterId} {
        allow read, write: if isValidId(roomId);
      }
      match /charm/{charmId} {
        allow read, write: if isValidId(roomId);
      }
      match /stats/{statDoc} {
        allow read, write: if isValidId(roomId);
      }
      match /clubMembers/{memberId} {
        allow read, write: if isValidId(roomId);
      }
    }

    // Health check collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
