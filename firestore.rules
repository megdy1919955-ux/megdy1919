rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // 🛡️ Global default deny
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 🔧 Helper Functions
    // ═══════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'megdy1919@gmail.com' ||
        request.auth.uid == '0OW7yfypGLgOgwbBHOVtpV8FJ3A3' ||
        getUserRole() == 'owner' ||
        getUserRole() == 'super_admin'
      );
    }

    function isManager() {
      return isSignedIn() && getUserRole() == 'manager';
    }

    function isDelegate() {
      return isSignedIn() && getUserRole() == 'delegate';
    }

    function isAgencyOwner() {
      return isSignedIn() && getUserRole() == 'agency_owner';
    }

    function isBroker() {
      return isSignedIn() && getUserRole() == 'broker';
    }

    function isHost() {
      return isSignedIn() && getUserRole() == 'host';
    }

    function isManagerOrOwner() {
      return isOwner() || isManager();
    }

    function isHierarchyRole() {
      return isManagerOrOwner() || isDelegate() || 
             isAgencyOwner() || isBroker() || isHost();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidRoom(data) {
      return data.roomId is string && data.roomId.size() > 0 && data.roomId.size() <= 128 &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
             (!('wallpaperUrl' in data) || (data.wallpaperUrl is string && data.wallpaperUrl.size() <= 5000000)) &&
             (!('roomTitle' in data) || (data.roomTitle is string && data.roomTitle.size() <= 500)) &&
             (!('roomAvatar' in data) || (data.roomAvatar is string && data.roomAvatar.size() <= 5000000)) &&
             (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 200)) &&
             (!('wallpaperName' in data) || (data.wallpaperName is string && data.wallpaperName.size() <= 200)) &&
             (!('themeConfig' in data) || (data.themeConfig is map)) &&
             (!('createdAt' in data) || (data.createdAt is string)) &&
             (!('updatedAt' in data) || (data.updatedAt is string));
    }

    // ═══════════════════════════════════════════════════════════
    // 🎙️ Rooms
    // ═══════════════════════════════════════════════════════════
    match /rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if true;
      
      allow create: if isSignedIn() && 
                    isValidId(roomId) && 
                    (!('roomId' in incoming()) || incoming().roomId == roomId) &&
                    (!('ownerId' in incoming()) || incoming().ownerId == request.auth.uid);
      
      allow update: if isSignedIn() && 
                    isValidId(roomId) && 
                    (!('roomId' in incoming()) || incoming().roomId == roomId) &&
                    (resource.data.ownerId == request.auth.uid || isManagerOrOwner());
      
      allow delete: if isSignedIn() && 
                    (resource.data.ownerId == request.auth.uid || isManagerOrOwner());

      match /messages/{messageId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
      match /seats/{seatId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
      match /cinema/{cinemaDoc} {
        allow read, write: if isSignedIn();
      }
      match /signals/{signalId} {
        allow read, write: if isSignedIn();
      }
      match /events/{eventId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
      match /supporters/{supporterId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
      match /charm/{charmId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
      match /stats/{statDoc} {
        allow read: if true;
        allow write: if isSignedIn();
      }
      match /clubMembers/{memberId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ═══════════════════════════════════════════════════════════
    // 👤 Users
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['coins', 'diamonds', 'totalDiamondsEarned', 
                    'totalCoinsSpent', 'role', 'isOwner', 'hierarchyId'])) ||
        isManagerOrOwner() ||
        request.auth.token.admin == true
      );
      allow delete: if isSignedIn() && 
                    (request.auth.uid == userId || isManagerOrOwner());

      match /{subCollection=**} {
        allow read: if isSignedIn() && 
                    (request.auth.uid == userId || isManagerOrOwner());
        allow write: if isManagerOrOwner() || request.auth.token.admin == true;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // 🏢 Agencies
    // ═══════════════════════════════════════════════════════════
    match /agencies/{agencyId} {
      allow read: if isSignedIn();
      allow create: if isManagerOrOwner() && isValidId(agencyId);
      allow update: if isManagerOrOwner() ||
                    (isAgencyOwner() && 
                     resource.data.ownerUid == request.auth.uid);
      allow delete: if isManagerOrOwner();

      match /{subCollection=**} {
        allow read: if isSignedIn();
        allow write: if isManagerOrOwner() || 
                     (isAgencyOwner() && 
                      get(/databases/$(database)/documents/agencies/$(agencyId)).data.ownerUid == request.auth.uid);
      }
    }

    // ═══════════════════════════════════════════════════════════
    // 🤝 Brokers
    // ═══════════════════════════════════════════════════════════
    match /brokers/{brokerId} {
      allow read: if isSignedIn();
      allow create: if isManagerOrOwner() || isAgencyOwner();
      allow update: if isManagerOrOwner() ||
                    (isAgencyOwner() && resource.data.agencyGid != null) ||
                    (isBroker() && resource.data.brokerUid == request.auth.uid);
      allow delete: if isManagerOrOwner() || isAgencyOwner();
    }

    // ═══════════════════════════════════════════════════════════
    // 🎙️ Hosts (Admin SDK فقط)
    // ═══════════════════════════════════════════════════════════
    match /hosts/{hostId} {
      allow read: if isSignedIn();
      allow write: if false;
      
      match /{subCollection=**} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // 📨 Invites
    // ═══════════════════════════════════════════════════════════
    match /invites/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isAgencyOwner() || isBroker() || isManagerOrOwner();
      allow update, delete: if isManagerOrOwner() ||
                            (resource.data.fromUid == request.auth.uid);
    }

    match /agency_invites/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isManagerOrOwner() || isDelegate() || isAgencyOwner();
      allow update, delete: if isManagerOrOwner() ||
                            (resource.data.fromUid == request.auth.uid) ||
                            (resource.data.toUid == request.auth.uid);
    }

    // ═══════════════════════════════════════════════════════════
    // 📋 Requests
    // ═══════════════════════════════════════════════════════════
    match /agency_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isManagerOrOwner() ||
                    (isAgencyOwner() && resource.data.agencyGid != null) ||
                    (resource.data.fromUid == request.auth.uid);
      allow delete: if isManagerOrOwner() || 
                    (resource.data.fromUid == request.auth.uid);
    }

    // ═══════════════════════════════════════════════════════════
    // 👨👩👧 Families
    // ═══════════════════════════════════════════════════════════
    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isManagerOrOwner() ||
                    (resource.data.ownerUid == request.auth.uid);
      allow delete: if isManagerOrOwner() ||
                    (resource.data.ownerUid == request.auth.uid);
      
      match /{subCollection=**} {
        allow read: if isSignedIn();
        allow write: if isManagerOrOwner() ||
                     (get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid);
      }
    }

    match /family_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isManagerOrOwner() ||
                    (resource.data.fromUid == request.auth.uid);
      allow delete: if isManagerOrOwner() ||
                    (resource.data.fromUid == request.auth.uid);
    }

    // ═══════════════════════════════════════════════════════════
    // ⚙️ Configs (قراءة فقط — Admin SDK للكتابة)
    // ═══════════════════════════════════════════════════════════
    match /configs/{configId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /agency_configs/{configId} {
      allow read, write: if false;
    }

    match /levels_config/{levelId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // 🔢 Counters (مقيّد — نقل للسيرفر لاحقًا)
    // ═══════════════════════════════════════════════════════════
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && 
        incoming().keys().hasOnly([
          'lastCode', 'lastBrokerCode', 'lastHostCode', 
          'seq', 'updatedAt', 'value', 'current'
        ]);
      allow delete: if isManagerOrOwner();
    }

    // ═══════════════════════════════════════════════════════════
    // 🧪 Test
    // ═══════════════════════════════════════════════════════════
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }
  }
}
